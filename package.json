{
  "name": "pe-candidate-assignment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "drizzle-kit generate",
    "migrate:up": "node --env-file-if-exists=.env ./src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env --import tsx ./src/db/seed/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.32.1",
    "next": "^14.2.19",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.40",
    "prettier": "3.10.1",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^5.1.0"
  }
}
